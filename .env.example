# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed. Every variable below is consumed by
# docker-compose.yml; DB_HOST, DB_PORT, REDIS_URL, NODE_ENV and the Redis URL
# are hardcoded in the compose file and do not belong here.

# --- Database (MariaDB) ---
# MYSQL_ROOT_PASSWORD is used only by the db container for administration.
# DB_USER/DB_PASS are the application's credentials for DB_NAME.
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_NAME=potjepolariseren
DB_USER=pp_user
DB_PASS=change_me_db_password

# --- Application ---
JWT_SECRET=change_me_long_random_string
APP_URL=https://polariseren.example.org
BASE_URL=https://polariseren.example.org

# --- Replicate AI (scoring / transcription) ---
REPLICATE_API_KEY=r8_your_replicate_token

# --- SMTP (outbound mail; host/port are set in code, port 587 STARTTLS) ---
SMTP_USER=you@example.org
SMTP_PASSWORD=change_me_smtp_password

# --- nginx-proxy + acme-companion (reverse proxy / TLS) ---
# These drive the external `proxy` network. Point VIRTUAL_HOST/LETSENCRYPT_HOST
# at the public hostname and set a contact email for Let's Encrypt.
VIRTUAL_HOST=polariseren.example.org
LETSENCRYPT_HOST=polariseren.example.org
LETSENCRYPT_EMAIL=admin@example.org
